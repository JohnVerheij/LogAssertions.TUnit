<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>LogAssertions</RootNamespace>
    <AssemblyName>LogAssertions</AssemblyName>
    <IsPublishable>false</IsPublishable>

    <!-- Package identity -->
    <IsPackable>true</IsPackable>
    <PackageId>LogAssertions</PackageId>
    <ProductName>LogAssertions</ProductName>
    <Version>0.17.0</Version>
    <PackageValidationBaselineVersion>0.16.0</PackageValidationBaselineVersion>
    <Authors>John Verheij</Authors>
    <Copyright>Copyright (c) 2026 John Verheij</Copyright>
    <Description>Framework-agnostic core for fluent log assertions over Microsoft.Extensions.Logging.Testing.FakeLogCollector. Provides ILogRecordFilter + LogFilter composable filter primitives, the failure-message rendering, the FakeLogCollector inspection extensions (Filter, CountMatching, DumpTo), event-driven waits for background logs (WaitForLogAsync, WaitForLogsAsync on FakeLogCollector.GetLogsAsync), the LogCollectorBuilder factories (Create returns a LogCapture, CreateDiscarding), and deterministic renderers for snapshot baselines (LogSnapshotRenderer for captured records, LogContractRenderer for log definitions). Test-framework-specific entry points live in adapter packages (LogAssertions.TUnit); adapters for other test frameworks are not planned, as the family targets TUnit.</Description>
    <PackageTags>assertions;testing;logging;fakelogcollector;microsoft-extensions-logging;dotnet;aot</PackageTags>
    <PackageProjectUrl>https://logassertions.dev</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Fallback: nuget.org renders this as a clickable link to the matching GitHub release.
         Directory.Build.targets overrides this at pack time when CHANGELOG.md contains a
         matching '## [$(Version)]' section, in which case the section body becomes the
         Release Notes shown on nuget.org. -->
    <PackageReleaseNotes>$(RepositoryUrl)/releases/tag/v$(Version)</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Pre-1.0 suppressions:
         Proj0212/Proj0213: PackageIcon and PackageIconUrl omitted; will be added by 1.0.0.
         (Proj0241 is no longer suppressed because PackageValidationBaselineVersion
         above pins to the previous shipped version of this package - keep the
         baseline value in sync with each release; do not pin a specific version
         number in this comment to avoid drift.) -->
    <NoWarn>$(NoWarn);Proj0212;Proj0213</NoWarn>

    <!-- Symbol package + API compat (strict mode quad per dpfa Proj0249/0250/0251/0252) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
    <EnableStrictModeForBaselineValidation>true</EnableStrictModeForBaselineValidation>
    <ApiCompatGenerateSuppressionFile>true</ApiCompatGenerateSuppressionFile>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
    <ApiCompatEnableRuleAttributesMustMatch>true</ApiCompatEnableRuleAttributesMustMatch>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- SBOM generation per dpfa Proj0243 (Microsoft.Sbom.Targets pack-time generation).
         SPDX 3.0 (April 2024) emits richer security-profile metadata than 2.2 / 2.3: better
         positioned for CRA Annex I §2(1) "commonly used and machine-readable format" alignment.
         Tooling lag note: very old scanners that don't yet parse SPDX 3.0 fall back to the
         CycloneDX 1.6 sibling artifact emitted by the release workflow. -->
    <GenerateSBOM>true</GenerateSBOM>
    <SbomGenerationManifestInfo>SPDX:3.0</SbomGenerationManifestInfo>

    <!-- AOT / trimming - core code uses no reflection, safe for AOT-mode test contexts -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alphabetical per dpfa Proj0015 -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Codifies the no-reflection convention from CONVENTIONS.md as a build-time error.
         RS0030 fires if any banned API is referenced from production code; combined with
         TreatWarningsAsErrors=true the build fails. Test projects do not reference this file
         so reflection-using helpers (e.g. PublicApiGenerator) stay usable in tests. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../../BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source generator behind [assembly: GenerateLogDefinitions] ships in this package under analyzers/dotnet/cs,
         where the compiler of every consuming project loads it. A project reference would make it a dependency of
         this package, so pack takes the built file by path; the target below builds it first. -->
    <None Include="../LogAssertions.Generator/bin/$(Configuration)/netstandard2.0/LogAssertions.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- A pack that builds (dotnet pack without no-build, a solution-level pack too) builds the generator before it collects
       the package files, so the DLL it packs is current and present on a clean tree. A no-build pack, as in CI after the
       solution build, takes the built file. The global properties of this project pass on, so a solution build reuses
       its own build of the generator. -->
  <Target Name="BuildLogDefinitionGenerator" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="../LogAssertions.Generator/LogAssertions.Generator.csproj" Targets="Build" />
  </Target>

  <ItemGroup>
    <!-- The TUnit adapter consults the internal LogCaptureFloorRegistry to detect a vacuous
         below-floor HasNotLogged assertion; no public API is added for it. The core tests read a record stream that
         ends through the wait's internal loop, which FakeLogCollector's stream never does. -->
    <InternalsVisibleTo Include="LogAssertions.TUnit" />
    <InternalsVisibleTo Include="LogAssertions.Tests" />
  </ItemGroup>

</Project>
