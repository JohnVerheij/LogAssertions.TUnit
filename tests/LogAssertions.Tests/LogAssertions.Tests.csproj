<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Framework-agnostic test project for the LogAssertions core package.

    Intentionally references ONLY LogAssertions, NOT LogAssertions.TUnit. The TUnit
    test runner is referenced for [Test]/[Category]/Assert.That infrastructure, but
    every test in this project exercises the core types (LogFilter, LogCollectorBuilder,
    FakeLogCollectorInspectionExtensions, LogAssertionRendering) directly without going
    through any LogAssertions.TUnit assertion entry point. If the core ever picked up
    a TUnit dependency by accident, this project would fail to compile.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>LogAssertions.Tests</RootNamespace>
    <AssemblyName>LogAssertions.Tests</AssemblyName>

    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alphabetical per dpfa Proj0015. Microsoft.CodeAnalysis.CSharp compiles a snippet against the core in a test,
         to pin the build error a deconstruction of LogCapture reports, and drives the log-definition generator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LogAssertions/LogAssertions.csproj" />
    <!-- The generator runs on this project (Analyzer) and its unit tests drive it directly (the referenced assembly).
         The two fixtures are the product-style assemblies it generates definitions for, one per Microsoft logging
         generator. -->
    <ProjectReference Include="../../src/LogAssertions.Generator/LogAssertions.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../LogAssertions.Generator.Fixture/LogAssertions.Generator.Fixture.csproj" />
    <ProjectReference Include="../LogAssertions.Generator.Fixture.Extensions/LogAssertions.Generator.Fixture.Extensions.csproj" />
  </ItemGroup>

</Project>
